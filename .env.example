# Local Minikube setup: copy to .env and edit before importing the Secret.
# Used by deploy/helm/examples/minikube.yaml with release boxmot.
# Plain KEY=value only: no shell quotes, export, interpolation or inline comments.
# Import instructions: docs/integrations/kubernetes.md, Start on Minikube.

# Network stream reachable from the cluster; publish a USB webcam over the network.
CAMERA_01_URL=rtsp://camera-host:554/stream

# For an existing database, use its current password; this does not rotate it.
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Repeat the same password here, percent-encoded if it contains URI special characters.
# boxmot-postgres is the bundled service for Helm release boxmot.
DATABASE_URL=postgresql://boxmot:replace-with-your-local-database-password@boxmot-postgres:5432/boxmot
